---
import { site } from '../config/site.js'

const year = new Date().getFullYear()

const mobileShopLinks = site.footer.shopLinks.filter((item) => item.mobile !== false)
const mobileCompanyLinks = site.footer.companyLinks.filter((item) => item.mobile !== false)
---

<footer class="site-footer">
  <div class="footer-shell">
    <div class="footer-top">
      <section class="footer-brand">
        <a href="/" class="footer-brand__mark" aria-label={`${site.name} home`}>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
          <span>orilabオリ</span>
        </a>

        <p>{site.footer.description}</p>
      </section>

      <nav class="footer-column footer-column--shop" aria-label="Shop links">
        <h2>Shop</h2>

        {
          site.footer.shopLinks.map((item) => (
            <a href={item.href} data-mobile-hidden={item.mobile === false || undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>

      <nav class="footer-column footer-column--company" aria-label="Company links">
        <h2>Company</h2>

        {
          site.footer.companyLinks.map((item) => (
            <a href={item.href} data-mobile-hidden={item.mobile === false || undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>

      <section class="footer-column footer-column--contact">
        <h2>Contact</h2>

        <a href={`mailto:${site.email}`}>{site.email}</a>

        {
          site.whatsapp && (
            <a href={site.whatsapp} target="_blank" rel="noopener noreferrer">
              WhatsApp
            </a>
          )
        }

        <p>{site.address}</p>

        {
          site.footer.sampleKit.enabled && (
            <a class="footer-sample-cta" href={site.footer.sampleKit.href}>
              {site.footer.sampleKit.label}
              <span aria-hidden="true">→</span>
            </a>
          )
        }

        <div class="footer-socials">
          {
            site.instagram && (
              <a
                href={site.instagram}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Instagram"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <rect
                    x="2.5"
                    y="2.5"
                    width="19"
                    height="19"
                    rx="5"
                    stroke="currentColor"
                    stroke-width="1.8"
                  />
                  <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.8" />
                  <circle cx="17.4" cy="6.6" r="0.8" fill="currentColor" />
                </svg>
              </a>
            )
          }

          {
            site.facebook && (
              <a
                href={site.facebook}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Facebook"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M13.5 21v-7.2h2.4l.4-2.8h-2.8V9.2c0-.8.3-1.4 1.5-1.4h1.4V5.3c-.3 0-1.1-.1-2-.1-2 0-3.4 1.2-3.4 3.5V11H8.5v2.8H11V21h2.5z" />
                </svg>
              </a>
            )
          }
        </div>
      </section>
    </div>

    <div class="footer-bottom">
      <p>© {year} {site.name}</p>
      <a href="/sitemap-index.xml">Sitemap</a>
    </div>
  </div>

  <div class="footer-mobile">
    <a href="/" class="footer-brand__mark" aria-label={`${site.name} home`}>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span>ORILAB</span>
    </a>

    <p class="footer-mobile__intro">
      Thoughtful goods for every pet. Wholesale, made clear.
    </p>

    <div class="footer-mobile__divider"></div>

    <div class="footer-mobile__links">
      <nav aria-label="Mobile shop links">
        <h2>Shop</h2>
        {mobileShopLinks.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>

      <nav aria-label="Mobile company links">
        <h2>Company</h2>
        {mobileCompanyLinks.map((item) => <a href={item.href}>{item.label}</a>)}
        <a class="footer-mobile__email" href={`mailto:${site.email}`}>{site.email}</a>
      </nav>
    </div>

    {
      site.footer.sampleKit.enabled && (
        <a class="footer-mobile__cta" href={site.footer.sampleKit.href}>
          {site.footer.sampleKit.label}
        </a>
      )
    }

    <div class="footer-mobile__bottom">
      <span>© {year} orilab</span>
      <a href="/sitemap-index.xml">Sitemap</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 48px 24px 24px;
    background: var(--color-surface-soft);
  }

  .footer-shell {
    width: min(1280px, 100%);
    min-height: 430px;
    margin: 0 auto;
    padding: 34px 48px 24px;
    border-radius: var(--radius-card);
    background: var(--color-ink);
    color: white;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.35fr 0.8fr 0.8fr 1.1fr;
    gap: 48px;
  }

  .footer-brand__mark {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: white;
    font-family: var(--font-pixel);
    font-size: 12px;
    line-height: 18px;
    text-decoration: none;
  }

  .footer-brand__mark span:first-child {
    width: 14px;
    height: 14px;
    border-radius: var(--radius-pixel);
    background: var(--color-brand-primary);
  }

  .footer-brand__mark span:nth-child(2) {
    width: 10px;
    height: 10px;
    border-radius: var(--radius-pixel);
    background: #f6c945;
  }

  .footer-brand p {
    max-width: 300px;
    margin: 22px 0 0;
    color: var(--color-border);
    font-size: 12px;
    line-height: 18px;
  }

  .footer-column h2,
  .footer-mobile h2 {
    margin: 24px 0 18px;
    color: #f6c945;
    font-family: var(--font-pixel);
    font-size: 11px;
    font-weight: 400;
    line-height: 16px;
    text-transform: uppercase;
  }

  .footer-column h2 {
    margin-top: 28px;
  }

  .footer-column a,
  .footer-column p {
    display: block;
    margin: 0 0 10px;
    color: white;
    font-size: 12px;
    line-height: 18px;
    text-decoration: none;
  }

  .footer-column a:hover {
    color: var(--color-brand-primary);
  }

  .footer-column p {
    color: var(--color-border);
  }

  .footer-sample-cta {
    display: inline-flex !important;
    align-items: center;
    gap: 8px;
    min-height: 32px;
    margin-top: 14px !important;
    padding: 0 12px;
    border-radius: var(--radius-control);
    background: var(--color-interactive);
    color: white !important;
    font-family: var(--font-pixel);
    font-size: 8px !important;
    text-decoration: none;
  }

  .footer-sample-cta:hover {
    background: var(--color-interactive-hover);
  }

  .footer-socials {
    display: flex;
    gap: 10px;
    margin-top: 18px;
  }

  .footer-socials a {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    margin: 0;
    border-radius: var(--radius-control);
    background: white;
    color: var(--color-ink);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
    color: var(--color-border);
    font-size: 13px;
    line-height: 16px;
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer-bottom a {
    color: inherit;
    text-decoration: none;
  }

  .footer-mobile {
    display: none;
  }

  @media (max-width: 767px) {
    .site-footer {
      padding: 24px 12px;
    }

    .footer-shell {
      display: none;
    }

    .footer-mobile {
      display: flex;
      flex-direction: column;
      min-height: 520px;
      padding: 24px;
      border-radius: var(--radius-shell);
      background: var(--color-ink);
      color: white;
    }

    .footer-mobile__intro {
      margin: 22px 0;
      color: white;
      font-size: 12px;
      line-height: 18px;
    }

    .footer-mobile__divider {
      height: 1px;
      background: var(--color-border);
    }

    .footer-mobile__links {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      margin-top: 16px;
    }

    .footer-mobile h2 {
      margin: 0 0 10px;
    }

    .footer-mobile__links a {
      display: block;
      margin-bottom: 8px;
      color: white;
      font-size: 12px;
      line-height: 18px;
      text-decoration: none;
    }

    .footer-mobile__links a:hover {
      color: var(--color-brand-primary);
    }

    .footer-mobile__email {
      color: var(--color-muted) !important;
    }

    .footer-mobile__cta {
      display: grid;
      place-items: center;
      min-height: 44px;
      margin-top: 24px;
      border-radius: var(--radius-control);
      background: var(--color-interactive);
      color: white;
      font-size: 12px;
      text-decoration: none;
    }

    .footer-mobile__cta:hover {
      background: var(--color-interactive-hover);
    }

    .footer-mobile__bottom {
      display: flex;
      justify-content: space-between;
      margin-top: auto;
      padding-top: 24px;
      color: var(--color-muted);
      font-family: Arial, sans-serif;
      font-size: 13px;
      line-height: 16px;
    }

    .footer-mobile__bottom a {
      color: inherit;
      text-decoration: none;
    }
  }
</style>