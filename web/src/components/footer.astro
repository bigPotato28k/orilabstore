---
import { site } from '../config/site.js'

const year = new Date().getFullYear()
const whatsappHref = `https://wa.me/${site.whatsapp.replace(/\D/g, '')}`
---

<footer class="site-footer">
  <div class="footer-shell">
    <section class="footer-brand">
      <a href="/" class="footer-brand__lockup" aria-label="orilabオリ home">
        <span class="footer-brand__pixels" aria-hidden="true">
          <i></i><i></i>
        </span>

        <span class="footer-brand__desktop-name">orilabオリ</span>
        <span class="footer-brand__mobile-name">ORILAB</span>
      </a>

      <p>{site.footer.description}</p>
    </section>

    <div class="footer-link-groups">
      <nav class="footer-column" aria-label="Shop links">
        <h2>SHOP</h2>

        {
          site.footer.shopLinks.map((item) => (
            <a
              href={item.href}
              data-mobile-hidden={item.mobile === false || undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <nav class="footer-column" aria-label="Company links">
        <h2>COMPANY</h2>

        {
          site.footer.companyLinks.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))
        }
      </nav>
    </div>

    <section class="footer-contact">
      <h2>CONTACT</h2>

      <a href={`mailto:${site.email}`}>{site.email}</a>

      <a href={whatsappHref} target="_blank" rel="noopener noreferrer">
        WhatsApp&nbsp; {site.whatsapp}
      </a>

      <p>{site.address}</p>

      <a class="footer-sample-cta" href={site.footer.sampleKit.href}>
        {site.footer.sampleKit.label}
      </a>

      <div class="footer-socials" aria-label="Social media">
        {
          site.footer.socialLinks.map((social) =>
            social.href ? (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.label}
              >
                <img src={social.icon} alt="" width="26" height="26" />
              </a>
            ) : (
              <span
                class="footer-socials__placeholder"
                aria-label={`${social.label} link coming soon`}
                title={`${social.label} link coming soon`}
              >
                <img src={social.icon} alt="" width="26" height="26" />
              </span>
            )
          )
        }
      </div>
    </section>

    <div class="footer-divider"></div>

    <p class="footer-copyright">
      © {year}
      <span class="footer-copyright__desktop"> orilabオリ</span>
      <span class="footer-copyright__mobile"> orilab</span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-surface-soft);
  }

  .footer-shell {
    position: relative;
    display: grid;
    grid-template-columns: minmax(350px, 1fr) 430px 280px;
    gap: 40px;
    width: min(1440px, 100%);
    min-height: 430px;
    margin: 0 auto;
    padding: 34px 48px 0;
    border-radius: var(--radius-card);
    background: var(--color-ink);
    color: white;
  }

  .footer-brand__lockup {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: max-content;
    color: white;
    font-family: var(--font-pixel);
    text-decoration: none;
  }

  .footer-brand__pixels {
    position: relative;
    display: block;
    width: 26px;
    height: 24px;
  }

  .footer-brand__pixels i:first-child {
    display: block;
    width: 14px;
    height: 14px;
    background: var(--color-brand-primary);
  }

  .footer-brand__pixels i:last-child {
    position: absolute;
    top: 12px;
    left: 16px;
    width: 12px;
    height: 12px;
    background: var(--color-brand-accent);
  }

  .footer-brand__desktop-name {
    font-size: 16px;
    line-height: 22px;
  }

  .footer-brand__mobile-name {
    display: none;
  }

  .footer-brand p {
    max-width: 300px;
    margin: 20px 0 0;
    color: var(--color-border);
    font-size: 12px;
    line-height: 18px;
  }

  .footer-link-groups {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    padding-top: 25px;
  }

  .footer-contact {
    padding-top: 25px;
  }

  .footer-column h2,
  .footer-contact h2 {
    margin: 0 0 24px;
    color: var(--color-brand-accent);
    font-family: var(--font-pixel);
    font-size: 12px;
    font-weight: 400;
    line-height: 18px;
  }

  .footer-column a,
  .footer-contact > a:not(.footer-sample-cta),
  .footer-contact p {
    display: block;
    margin: 0 0 14px;
    color: white;
    font-size: 12px;
    line-height: 18px;
    text-decoration: none;
  }

  .footer-column a:hover,
  .footer-column a:focus-visible,
  .footer-contact > a:not(.footer-sample-cta):hover,
  .footer-contact > a:not(.footer-sample-cta):focus-visible {
    color: var(--color-brand-primary);
  }

  .footer-sample-cta {
    display: grid;
    place-items: center;
    width: 208px;
    height: 27px;
    margin-top: 24px;
    border-radius: var(--radius-control);
    background: var(--color-interactive);
    color: white;
    font-size: 12px;
    font-weight: 700;
    line-height: 18px;
    text-decoration: none;
    transition: background-color 160ms ease, transform 160ms ease;
  }

  .footer-sample-cta:hover,
  .footer-sample-cta:focus-visible {
    background: var(--color-interactive-hover);
    transform: translateY(-1px);
  }

  .footer-socials {
    display: flex;
    gap: 12px;
    margin-top: 35px;
  }

  .footer-socials a,
  .footer-socials__placeholder {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
  }

  .footer-socials img {
    display: block;
    width: 26px;
    height: 26px;
  }

  .footer-socials a {
    transition: transform 160ms ease;
  }

  .footer-socials a:hover,
  .footer-socials a:focus-visible {
    transform: translateY(-2px);
  }

  .footer-socials__placeholder {
    cursor: default;
  }

  .footer-divider {
    position: absolute;
    right: 59px;
    bottom: 77px;
    left: 48px;
    height: 1px;
    background: var(--color-border);
  }

  .footer-copyright {
    position: absolute;
    bottom: 48px;
    left: 48px;
    margin: 0;
    color: var(--color-border);
    font-family: var(--font-display);
    font-size: 13px;
    line-height: 16px;
  }

  .footer-copyright__mobile {
    display: none;
  }

  @media (max-width: 1023px) and (min-width: 768px) {
    .footer-shell {
      grid-template-columns: minmax(220px, 1fr) 1fr;
    }

    .footer-contact {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    .footer-contact h2,
    .footer-contact > a:not(.footer-sample-cta),
    .footer-contact p {
      margin: 0;
    }

    .footer-sample-cta {
      margin: 0;
    }

    .footer-socials {
      margin: 0;
    }
  }

  @media (max-width: 767px) {
    .footer-shell {
      display: flex;
      flex-direction: column;
      gap: 18px;
      min-height: 0;
      padding: 24px;
      border-radius: var(--radius-shell);
    }

    .footer-brand {
      padding-bottom: 18px;
      border-bottom: 1px solid var(--color-border);
    }

    .footer-brand__lockup {
      flex-direction: row;
      align-items: center;
      gap: 8px;
    }

    .footer-brand__pixels {
      width: 32px;
      height: 14px;
    }

    .footer-brand__pixels i:first-child {
      width: 14px;
      height: 14px;
      border-radius: var(--radius-pixel);
    }

    .footer-brand__pixels i:last-child {
      top: 2px;
      left: 22px;
      width: 10px;
      height: 10px;
      border-radius: var(--radius-pixel);
      background: var(--color-brand-primary);
    }

    .footer-brand__desktop-name {
      display: none;
    }

    .footer-brand__mobile-name {
      display: block;
      font-size: 12px;
      line-height: 18px;
    }

    .footer-brand p {
      max-width: none;
      margin: 18px 0 0;
    }

    .footer-link-groups {
      gap: 24px;
      padding-top: 0;
    }

    .footer-column h2,
    .footer-contact h2 {
      margin-bottom: 8px;
      font-size: 11px;
      line-height: 16px;
    }

    .footer-column a {
      margin-bottom: 8px;
    }

    .footer-column [data-mobile-hidden] {
      display: none;
    }

    .footer-contact {
      display: contents;
    }

    .footer-contact > h2,
    .footer-contact > a:not(.footer-sample-cta),
    .footer-contact > p {
      display: none;
    }

    .footer-sample-cta {
      order: 4;
      width: 100%;
      height: 44px;
      margin-top: 0;
      font-weight: 400;
    }

    .footer-socials {
      order: 5;
      justify-content: center;
      width: 100%;
      margin: 0;
      padding: 4px 0;
    }

    .footer-divider {
      display: none;
    }

    .footer-copyright {
      position: static;
      order: 6;
      margin: 0;
      color: var(--color-muted);
    }

    .footer-copyright__desktop {
      display: none;
    }

    .footer-copyright__mobile {
      display: inline;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-sample-cta,
    .footer-socials a {
      transition: none;
    }
  }
</style>
