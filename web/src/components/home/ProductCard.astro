---
const { product, imageUrl, index = 0 } = Astro.props

const productName = product?.productname || 'Best seller coming soon'
const collectionName = product?.selectCollection?.title || 'ORILAB'
const productHref = product?.slug?.current ? `/product/${product.slug.current}` : undefined
---

<article class="product-card" style={`--product-index: ${index}`}>
  {productHref ? (
    <a class="product-card__link" href={productHref} aria-label={`View ${productName}`}>
      <div class="product-card__image-wrap">
        {imageUrl ? (
          <img src={imageUrl} alt={productName} class="product-card__image" loading="lazy" />
        ) : (
          <div class="product-card__placeholder" aria-hidden="true">
            <span>COMING SOON</span>
          </div>
        )}
      </div>
    </a>
  ) : (
    <div class="product-card__image-wrap" aria-hidden="true">
      <div class="product-card__placeholder"><span>COMING SOON</span></div>
    </div>
  )}

  <div class="product-card__details">
    <p>{collectionName}</p>
    <h3>{productName}</h3>
  </div>
</article>

<style>
  .product-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: 0 12px 24px rgb(60 44 51 / 8%);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 28px rgb(60 44 51 / 15%);
  }

  .product-card__link {
    display: block;
  }

  .product-card__image-wrap {
    aspect-ratio: 1.62 / 1;
    overflow: hidden;
    background: var(--color-surface-soft);
  }

  .product-card__image,
  .product-card__placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }

  .product-card__image {
    object-fit: cover;
    transition: transform 280ms ease;
  }

  .product-card:hover .product-card__image {
    transform: scale(1.04);
  }

  .product-card__placeholder {
    display: grid;
    place-items: center;
    background:
      linear-gradient(135deg, rgb(82 183 136 / 14%), rgb(255 255 255 / 5%)),
      repeating-linear-gradient(45deg, transparent 0 16px, rgb(255 255 255 / 42%) 16px 17px),
      #d8efe1;
    color: #438461;
    font-family: var(--font-pixel);
    font-size: 8px;
    letter-spacing: 0.04em;
  }

  .product-card__details {
    min-height: 91px;
    padding: 16px;
  }

  .product-card__details p,
  .product-card__details h3 {
    margin: 0;
  }

  .product-card__details p {
    color: var(--color-brand-primary);
    font-family: var(--font-pixel);
    font-size: 8px;
    line-height: 14px;
  }

  .product-card__details h3 {
    margin-top: 8px;
    color: var(--color-ink);
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }

  @media (max-width: 767px) {
    .product-card__details {
      min-height: 85px;
      padding: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card,
    .product-card__image {
      transition: none;
    }
  }
</style>
