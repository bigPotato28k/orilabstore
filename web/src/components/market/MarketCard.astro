---
const { product, imageUrl, hoverImageUrl, tag } = Astro.props
---
<a class="market-card" href={`/product/${product.slug.current}`} data-market-product data-filter={product.collection?._id} data-name={product.productname.toLowerCase()} data-date={product._createdAt}>
  <span class="market-card__image"><img src={imageUrl} alt={product.coverImage?.alt || product.productname} loading="lazy" width="624" height="352" />{hoverImageUrl && <img class="market-card__hover" src={hoverImageUrl} alt="" loading="lazy" width="624" height="352" />}</span>
  <span class="market-card__tag">{tag}</span><strong>{product.productname}</strong><small>{product.shortDescription || 'A soft, stitch-led detail for your collection.'}</small>
</a>
<style>.market-card{display:block;height:332px;padding:12px;border:1px solid var(--color-border);border-radius:12px;background:#fff;color:var(--color-ink);text-decoration:none}.market-card__image{position:relative;display:block;height:176px;overflow:hidden;border-radius:12px;background:var(--color-surface-soft)}.market-card__image img{width:100%;height:100%;object-fit:cover;transition:opacity .25s ease}.market-card__hover{position:absolute;inset:0;opacity:0}.market-card:hover .market-card__hover,.market-card:focus-visible .market-card__hover{opacity:1}.market-card__tag{display:table;margin-top:10px;padding:4px;border:1px solid var(--color-border);border-radius:8px;background:var(--color-surface-soft);font-size:12px;line-height:16px}.market-card strong{display:block;margin-top:8px;font-size:20px;font-weight:500;line-height:30px}.market-card small{display:block;display:-webkit-box;overflow:hidden;margin-top:2px;color:var(--color-muted);font-size:12px;line-height:18px;-webkit-box-orient:vertical;-webkit-line-clamp:2}@media(max-width:767px){.market-card{width:338px;max-width:100%;margin:auto}}</style>
