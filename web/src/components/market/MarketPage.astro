---
import MarketCard from './MarketCard.astro'
import { urlFor } from '../../lib/sanity.js'
const { config, collections, products, initialFilter = 'all' } = Astro.props
const labels = { Book_Station: 'Book & Station', Phone_Accessories: 'Phone Accessories', Personal_Accessories: 'Personal Accessories', Lifestyle: 'Lifestyle', animals: 'Animals', food: 'Food', festival: 'Festival', nature: 'Nature' }
const tag = (collection) => labels[collection?.type || collection?.theme] || collection?.name || 'Collection'
const image = (asset, width, height) => asset ? urlFor(asset).width(width).height(height).fit('crop').auto('format').url() : null
const filterItems = [{ _id: 'all', name: 'All collections' }, ...collections]
const policy = [['24/7','Online service'],['◎','Factory direct'],['↗','Global shipping'],['✦','Made with care']]
---
<section class="market-hero"><img src={config.cover} alt="A selection of orilab embroidered goods" width="2880" height="813" /><nav><a href="/">Home</a><span>/</span><a href={config.route}>{config.title.replace(' Market','')}</a></nav></section>
<section class="market-shell" data-market data-initial-filter={initialFilter}>
  <header class="market-toolbar"><h1>{config.title}</h1><label>sort by : <select data-sort><option value="latest">Latest</option><option value="name">Name</option></select></label></header>
  <button class="market-mobile-filter" type="button" data-filter-toggle aria-expanded="false">COLLECTION SELECT <span data-filter-name>All collections</span><b>⌄</b></button>
  <div class="market-layout">
    <aside class="market-filters" data-filter-panel><p>COLLECTION SELECT</p>{filterItems.map((item) => <button type="button" data-filter={item._id}><img src={item._id === 'all' ? '/images/market/filter-active.svg' : '/images/market/filter-default.svg'} alt="" width="18" height="18" />{item.name}</button>)}</aside>
    <div><div class="market-products" data-products>{products.map((product) => <MarketCard product={product} imageUrl={image(product.coverImage,624,352)} hoverImageUrl={image(product.images?.[0],624,352)} tag={tag(product.collection)} />)}</div><p class="market-empty" data-empty hidden>No products are available in this collection yet.</p><nav class="market-pagination" aria-label="Product pages" data-pagination></nav></div>
  </div>
</section>
<section class="market-policy"><h2>Bring Joy Surround You With Safety</h2><div>{policy.map(([icon,title]) => <article><b>{icon}</b><strong>{title}</strong><small>Thoughtful wholesale support, from our studio to yours.</small></article>)}</div></section>
<script>
  document.querySelectorAll('[data-market]').forEach((market) => {
    const pageSize = 9, cards = [...market.querySelectorAll('[data-market-product]')], panel = market.querySelector('[data-filter-panel]'), toggle = market.querySelector('[data-filter-toggle]'), sort = market.querySelector('[data-sort]'), pages = market.querySelector('[data-pagination]'), empty = market.querySelector('[data-empty]'), name = market.querySelector('[data-filter-name]'); let filter = market.dataset.initialFilter || new URLSearchParams(location.search).get('collection') || 'all', page = 1;
    const render = () => { let list = cards.filter(c => filter === 'all' || c.dataset.filter === filter); list.sort((a,b) => sort.value === 'name' ? a.dataset.name.localeCompare(b.dataset.name) : b.dataset.date.localeCompare(a.dataset.date)); const count = Math.ceil(list.length / pageSize); page = Math.min(page, Math.max(count,1)); cards.forEach(c => c.hidden = true); list.slice((page-1)*pageSize,page*pageSize).forEach(c => c.hidden = false); empty.hidden = list.length > 0; panel.querySelectorAll('button').forEach(b => b.classList.toggle('is-active', b.dataset.filter === filter)); const active = panel.querySelector('.is-active'); name.textContent = active?.textContent.trim() || 'All collections'; pages.replaceChildren(); if (count > 1) { const add=(label,target,disabled=false)=>{const b=document.createElement('button');b.type='button';b.textContent=label;b.disabled=disabled;b.className=target===page?'is-active':'';b.onclick=()=>{page=target;render();scrollTo({top:market.offsetTop-88,behavior:'smooth'})};pages.append(b)};add('‹',page-1,page===1); for(let i=1;i<=Math.min(count,5);i++)add(String(i),i); add('›',page+1,page===count) } const params=new URLSearchParams(location.search); filter==='all'?params.delete('collection'):params.set('collection',filter); sort.value==='latest'?params.delete('sort'):params.set('sort',sort.value); history.replaceState(null,'',`${location.pathname}${params.size?`?${params}`:''}`) };
    panel.addEventListener('click', e => { const b=e.target.closest('[data-filter]'); if(!b)return;filter=b.dataset.filter;page=1;toggle.setAttribute('aria-expanded','false');market.classList.remove('filter-open');render() }); sort.addEventListener('change',()=>{page=1;render()});toggle.addEventListener('click',()=>{const open=market.classList.toggle('filter-open');toggle.setAttribute('aria-expanded',String(open))});render();
  })
</script>
<style>
  .market-hero{position:relative;width:100%;height:320px;margin:0;overflow:hidden;background:#4ca4c5}.market-hero>img{width:100%;height:100%;object-fit:cover}.market-hero::after{position:absolute;inset:0;background:linear-gradient(90deg,rgb(0 0 0/.2),transparent);content:''}.market-hero nav{position:absolute;z-index:1;top:16px;left:16px;display:flex;gap:8px;color:#fff;font-size:12px}.market-hero a{color:inherit;text-decoration:none}.market-shell{width:min(1340px,calc(100% - 48px));margin:0 auto 17px}.market-toolbar{display:flex;align-items:center;justify-content:space-between;padding:0 7px 0 12px;border-radius:12px;background:#fff;margin:17px 0px 0px;}.market-toolbar h1{margin:0;font-family:var(--font-pixel);font-size:14px;font-weight:400;line-height:54px}.market-toolbar label{padding:5px 12px;border:1px solid var(--color-border);border-radius:8px;font-size:13px}.market-toolbar select{border:0;background:transparent}.market-layout{display:grid;grid-template-columns:220px 1fr;gap:43px;margin-top:17px}.market-filters{min-height:807px;padding:12px;border-radius:12px;background:#fff}.market-filters p{margin:0 0 11px;font-size:12px}.market-filters button{display:flex;width:100%;min-height:38px;align-items:center;gap:8px;padding:8px;border:0;border-radius:8px;background:#fff;color:var(--color-ink);font-size:16px;line-height:22px;text-align:left;cursor:pointer;transition:background-color .18s ease,color .18s ease}.market-filters button img{flex-shrink:0}.market-filters button:not(.is-active):hover{background:var(--color-surface-soft)}.market-filters button.is-active{background:var(--color-brand-primary);color:#fff}.market-products{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.market-pagination{display:flex;justify-content:center;gap:13px;margin:16px}.market-pagination button{width:45px;height:45px;border:0;border-radius:50%;background:var(--color-surface-soft);color:var(--color-muted);font-family:var(--font-pixel);font-size:15px}.market-pagination button:first-child,.market-pagination button:last-child{font-size:0;background-repeat:no-repeat;background-position:center;background-size:24px}.market-pagination button:first-child{background-image:url('/images/market/pagination-left.svg')}.market-pagination button:last-child{background-image:url('/images/market/pagination-right.svg')}.market-pagination button.is-active{background-color:var(--color-brand-primary);color:white}.market-pagination button:disabled{opacity:.4}.market-empty{text-align:center}.market-mobile-filter{display:none}.market-policy{width:min(1332px,calc(100% - 48px));margin:0 auto 17px;padding:16px;text-align:center}.market-policy h2{margin:0 0 16px;font-family:var(--font-pixel);font-size:14px;line-height:44px}.market-policy>div{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.market-policy article{display:grid;min-height:195px;place-content:center;gap:8px;border-radius:8px;background:rgb(246 201 69/.2)}.market-policy b{color:var(--color-brand-primary);font-size:28px}.market-policy strong{font-size:16px;font-weight:500}.market-policy small{max-width:190px;color:var(--color-muted);font-size:12px;line-height:18px}@media(max-width:767px){.market-hero{width:100%;height:359px;margin:0;border-radius:0}.market-hero nav{top:87px;left:16px}.market-shell{width:calc(100% - 32px);margin-top:11px}.market-toolbar h1{font-size:11px;line-height:40px}.market-toolbar label{font-size:11px}.market-layout{display:block;margin-top:11px}.market-filters{position:absolute;z-index:4;display:none;min-height:0;width:calc(100% - 32px);box-shadow:0 12px 24px rgb(30 30 27/.16)}.filter-open .market-filters{display:block}.market-mobile-filter{display:flex;width:100%;align-items:center;gap:8px;padding:12px;border:1px solid var(--color-border);border-radius:12px;background:#fff;font-size:11px;text-align:left}.market-mobile-filter span{margin-left:auto;font-size:16px}.market-mobile-filter b{font-size:20px}.market-products{grid-template-columns:1fr;gap:16px;margin-top:11px}.market-policy{width:343px;max-width:calc(100% - 32px)}.market-policy h2{font-size:12px;line-height:23px}.market-policy>div{grid-template-columns:repeat(2,1fr);gap:9px}.market-policy article{min-height:94px}.market-policy small{display:none}}
</style>
