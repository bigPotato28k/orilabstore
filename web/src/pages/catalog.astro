---
import Base from '../layouts/base.astro'
import { catalogs } from '../config/catalog.js'
---
<Base title="Download Catalog | orilabオリ" description="Browse and download the current orilab wholesale catalog library.">
  <section class="catalog-hero"><p>/ CATALOG</p><h1>Download Catalog</h1><span>Browse the current orilab catalog library. Preview in your browser or download the PDF directly.</span></section>
  <section class="catalog-list">{catalogs.map((catalog) => <article><div class="cover" aria-hidden="true"><i></i><i></i><i></i><i></i><b>ORILAB<br/>CATALOG</b></div><h2>{catalog.title}</h2><p>{catalog.version} · {catalog.updatedAt}</p><div><a href={catalog.pdf} target="_blank" rel="noopener noreferrer">Preview</a><a class="download" href={catalog.pdf} download>Download PDF</a></div></article>)}</section>
  <section class="catalog-cta"><h2>Need a tailored collection?</h2><p>Start a wholesale inquiry and tell us what your store is looking for.</p><a href="/contact">Start Your Order</a></section>
</Base>
<style>.catalog-hero{min-height:254px;padding:67px max(56px,calc((100vw - 1216px)/2));background:#fff url('/images/catalog-contact-herocover.webp') center/cover no-repeat}.catalog-hero p{margin:0;color:var(--color-brand-primary);font-size:12px}.catalog-hero h1{margin:25px 0;font-family:var(--font-pixel);font-size:32px;font-weight:400;line-height:44px}.catalog-hero span{display:block;max-width:610px;color:var(--color-muted);font-size:16px;line-height:22px}.catalog-list{display:grid;grid-template-columns:repeat(3,376px);justify-content:center;gap:24px;padding:29px 24px 70px;background:#fff}.catalog-list article{height:365px;padding:16px;border:1px solid var(--color-border);border-radius:12px}.cover{position:relative;height:210px;overflow:hidden;border-radius:8px;background:var(--color-surface-soft)}.cover b{position:absolute;top:32px;left:calc(50% - 58px);display:grid;width:116px;height:144px;place-content:center;border:1px solid var(--color-border);background:#fff;font-family:var(--font-pixel);font-size:10px;line-height:18px;text-align:center}.cover i{position:absolute;width:16px;height:16px;background:var(--color-brand-primary)}.cover i:nth-child(1){top:16px;left:16px}.cover i:nth-child(2){top:32px;left:32px;width:10px;height:10px;background:var(--color-brand-accent)}.cover i:nth-child(3){top:54px;left:54%;width:22px;height:22px;background:#4cb9e7}.cover i:nth-child(4){top:76px;left:58%;width:10px;height:10px;background:var(--color-interactive)}.catalog-list h2{margin:12px 0 2px;font-size:20px;font-weight:500;line-height:30px}.catalog-list p{margin:0;color:var(--color-muted);font-size:12px}.catalog-list article>div:last-child{display:flex;gap:8px;margin-top:12px}.catalog-list a,.catalog-cta a{display:grid;height:44px;flex:1;place-items:center;border:1px solid var(--color-ink);border-radius:8px;color:var(--color-ink);font-size:12px;text-decoration:none}.catalog-list .download{border-color:var(--color-brand-primary);background:var(--color-brand-primary);color:#fff;font-weight:800}.catalog-cta{position:relative;min-height:224px;padding:52px max(56px,calc((100vw - 1328px)/2));background:var(--color-brand-primary);color:#fff}.catalog-cta h2{margin:0;font-family:var(--font-pixel);font-size:32px;font-weight:400;line-height:44px}.catalog-cta p{margin-top:42px;font-size:12px}.catalog-cta a{position:absolute;top:90px;right:max(56px,calc((100vw - 1328px)/2));width:184px;background:#fff;color:var(--color-brand-primary);font-weight:800}@media(max-width:767px){.catalog-hero{min-height:312px;padding:52px 24px}.catalog-hero h1{font-size:22px;line-height:34px}.catalog-hero span{font-size:14px}.catalog-list{grid-template-columns:1fr;padding:24px 16px}.catalog-list article{width:343px;max-width:100%;margin:auto}.catalog-cta{padding:40px 24px;min-height:260px}.catalog-cta h2{font-size:22px;line-height:34px}.catalog-cta a{position:static;width:184px;margin-top:25px}.catalog-cta p{margin-top:24px}}</style>
