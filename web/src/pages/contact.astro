---
import Base from '../layouts/base.astro'
const faq=[['What is your MOQ?','MOQ varies by product line — contact us for a quote.'],['Do you offer OEM / custom embroidery?','Yes. Tell us about your concept and we will advise on the next steps.'],['How does the DIY patch program work for retailers?','Choose accessories and original patches to create a flexible, in-store experience.'],['What are your lead times?','Lead times depend on the product and order requirements; we confirm them with your quote.'],['Can I request samples?','Yes. Use this form to request a sample kit.'],['How often do new series launch?','New patch series are planned regularly throughout the year.']]
const queryProduct=Astro.url.searchParams.get('product')||''
---
<Base title="Contact | orilabオリ" description="Start an orilab wholesale inquiry.">
 <section class="contact-hero"><p>/ CONTACT</p><h1>Let’s make your store a little softer.</h1><span>Tell us what you are looking for. We will reply with a clear next step.</span></section>
 <section class="contact-form"><h2>Tell Us About Your Store</h2><div class="contact-grid"><form data-contact-form><p>Complete the fields below and we will reply with the next steps.</p><div class="two"><label>Company<input name="company" placeholder="Your company name" required /></label><label>Country<input name="country" placeholder="Your country" required /></label></div><div class="two"><label>Business type<select name="businessType"><option>Select an option</option><option>Retail store</option><option>Distributor</option><option>Corporate gifting</option></select></label><label>Product line of interest<select name="productLine"><option>Select an option</option><option>Pet Collection</option><option>Patch Collection</option><option>OEM / Custom</option></select></label></div><label>Estimated quantity<input name="quantity" placeholder="Tell us your estimated quantity" /></label><label>Message<textarea name="message" placeholder="Tell us what you are looking for.">{queryProduct ? `I am interested in product: ${queryProduct}` : ''}</textarea></label><button type="submit">Send Inquiry</button><p class="form-note" data-form-note>Submission service will be connected later.</p></form><aside><h3>A clear path to order</h3><p>Inquiry → Quote → Sample → Order</p>{['Inquiry','Quote','Sample','Order'].map((x,i)=><div><b>0{i+1}</b>{x}</div>)}</aside></div></section>
 <section class="faq"><h2>FAQ</h2><p>Answers to common wholesale questions.</p>{faq.map(([q,a],i)=><details open={i===0}><summary>{q}<b></b></summary><p>{a}</p></details>)}</section>
</Base>
<script>document.querySelector('[data-contact-form]')?.addEventListener('submit',e=>{e.preventDefault();e.currentTarget.querySelector('[data-form-note]').textContent='Thank you — email delivery will be enabled when your form service is connected.'})</script>
<style>.contact-hero{min-height:356px;padding:70px max(56px,calc((100vw - 1328px)/2));background:var(--color-surface-soft)}.contact-hero p{color:var(--color-brand-primary);font-size:12px}.contact-hero h1{max-width:760px;font-family:var(--font-pixel);font-size:32px;font-weight:400;line-height:44px}.contact-hero span{max-width:540px;color:var(--color-muted);font-size:16px;line-height:22px}.contact-form{padding:80px max(56px,calc((100vw - 1328px)/2));background:#fff}.contact-form>h2,.faq h2{margin:0;font-size:24px;font-weight:500;line-height:40px}.contact-grid{display:grid;grid-template-columns:760px 536px;gap:32px;margin-top:32px}.contact-grid form,.contact-grid aside{height:640px;padding:32px;border-radius:12px}.contact-grid form{border:1px solid var(--color-border)}form>p,aside>p,.faq>p{margin:0 0 16px;color:var(--color-muted);font-size:12px;line-height:18px}.two{display:grid;grid-template-columns:1fr 1fr;gap:16px}label{display:grid;gap:8px;margin:0 0 16px;font-size:12px}input,select,textarea{width:100%;height:44px;padding:12px 16px;border:1px solid var(--color-border);border-radius:8px;background:#fff;font-size:12px}textarea{height:108px;resize:vertical}form button{width:184px;height:44px;border:0;border-radius:8px;background:var(--color-brand-primary);color:#fff;font-size:11px;font-weight:800}.form-note{margin-top:10px!important}aside{background:var(--color-surface-soft)}aside h3{margin:0;font-size:20px;font-weight:500}aside div{height:48px;margin-top:16px;padding:12px 16px;border-radius:8px;background:#fff;font-size:16px}aside b{margin-right:12px;color:var(--color-brand-primary);font-size:12px}.faq{padding:31px max(24px,calc((100vw - 1000px)/2)) 145px;background:#fff}.faq details{margin-top:12px;padding:16px 24px;border:1px solid var(--color-border);border-radius:8px}.faq details[open]{border-color:var(--color-brand-primary)}.faq summary{display:flex;justify-content:space-between;font-size:16px;line-height:28px;cursor:pointer;list-style:none}.faq summary b::before{color:var(--color-brand-primary);font-size:20px;content:'+'}.faq details[open] summary b::before{content:'−'}.faq details p{margin:12px 0 0;color:var(--color-muted);font-size:12px}@media(max-width:767px){.contact-hero{min-height:312px;padding:48px 24px}.contact-hero h1{font-size:22px;line-height:34px}.contact-hero span{font-size:14px}.contact-form{padding:48px 16px}.contact-grid{grid-template-columns:1fr;gap:16px}.contact-grid form{height:auto;padding:20px}.contact-grid aside{height:auto;padding:20px}.two{grid-template-columns:1fr}.faq{padding:35px 16px 80px}.faq details{padding:16px}.faq summary{font-size:14px;line-height:22px}}</style>
