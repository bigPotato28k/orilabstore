---
import Base from '../../layouts/base.astro'
import { urlFor } from '../../lib/sanity.js'
import { getProduct, getProductSlugs, getRelatedProducts } from '../../lib/catalog.js'
export async function getStaticPaths() { const entries = await getProductSlugs(); return entries.map(({slug}) => ({params:{slug}})) }
const product = await getProduct(Astro.params.slug)
if (!product) return Astro.redirect('/')
const related = await getRelatedProducts(product.collection?._id, product._id)
const collectionRoute = product.collection?._type === 'patchcollection' ? '/patch-collection' : '/pet-collection'
const media = [product.coverImage, ...(product.images || [])].filter(Boolean)
const image = (asset, width, height) => urlFor(asset).width(width).height(height).fit('crop').auto('format').url()
const title = product.seoTitle || `${product.productname} | orilabオリ`
const description = product.seoDescription || product.shortDescription || `Wholesale ${product.productname} from orilabオリ.`
const productJsonLd = {'@context':'https://schema.org','@type':'Product',name:product.productname,sku:product.sku,image:media.map(item => image(item,1200,1200)),description,brand:{'@type':'Brand',name:'orilabオリ'},category:product.collection?.name}
---
<Base {title} {description} ogImage={product.ogImage ? image(product.ogImage,1200,630) : image(product.coverImage,1200,630)}>
  <script type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
  <section class="detail">
    <nav class="crumb"><a href="/">Home</a><span>/</span><a href={collectionRoute}>{product.collection?._type === 'patchcollection' ? 'Patch Collection' : 'Pet Collection'}</a><span>/</span><span>{product.productname}</span></nav>
    <div class="detail-top"><div class="gallery" data-gallery><div class="gallery-thumbs">{media.map((asset,index) => <button class:list={{'is-active':index===0}} type="button" data-image={image(asset,1288,1040)} data-alt={asset.alt || product.productname}><img src={image(asset,152,176)} alt="" loading="lazy" /></button>)}</div><button class="gallery-main" type="button" data-main><img src={image(media[0],1288,1040)} alt={media[0]?.alt || product.productname} width="644" height="520" /></button></div>
      <article class="detail-info"><p>{product.collection?.name} · {product.collection?.type || product.collection?.theme}</p><h1>{product.productname}</h1><p class="detail-short">{product.shortDescription}</p><div class="specs"><div><small>SKU</small><span>{product.sku || 'Available on request'}</span></div><div><small>COLLECTION</small><span>{product.collection?.name}</span></div><div><small>MATERIAL</small><span>{product.material || 'Available on request'}</span></div><div><small>SIZE</small><span>{product.size || 'Available on request'}</span></div></div><a class="quote" href={`/contact?product=${encodeURIComponent(product.slug.current)}`}>Request a Quote&nbsp; →</a></article></div>
    <section class="description"><div><h2>DESCRIPTION</h2><p>{product.longDescriptionText || product.shortDescription}</p></div><div class="detail-images">{media.slice(1,3).map(asset => <img src={image(asset,652,380)} alt={asset.alt || product.productname} loading="lazy" width="326" height="190" />)}</div></section>
    <section class="related"><h2>MORE FROM {product.collection?.name}</h2><div>{related.map(item => <a href={`/product/${item.slug.current}`}><img src={image(item.coverImage,582,300)} alt={item.coverImage?.alt || item.productname} loading="lazy" width="291" height="150" /><small>{item.collection?.name}</small><strong>{item.productname}</strong><span>{item.shortDescription}</span></a>)}</div></section>
  </section>
</Base>
<script>document.querySelectorAll('[data-gallery]').forEach(g=>{const main=g.querySelector('[data-main] img');g.querySelectorAll('[data-image]').forEach(b=>b.addEventListener('click',()=>{main.src=b.dataset.image;main.alt=b.dataset.alt;g.querySelectorAll('[data-image]').forEach(x=>x.classList.toggle('is-active',x===b))}));g.querySelector('[data-main]').addEventListener('click',()=>main.classList.toggle('is-zoomed'))})</script>
<style>
 .detail{width:min(1328px,calc(100% - 48px));margin:30px auto 50px}.crumb{display:flex;gap:8px;font-size:12px}.crumb a{color:var(--color-ink)}.detail-top{display:grid;grid-template-columns:744px 532px;gap:52px;margin-top:24px}.gallery{display:grid;grid-template-columns:76px 644px;gap:24px}.gallery-thumbs{display:grid;align-content:start;gap:16px}.gallery-thumbs button{width:76px;height:88px;padding:0;overflow:hidden;border:1px solid transparent;border-radius:12px;background:var(--color-surface-soft)}.gallery-thumbs button.is-active{border-color:var(--color-brand-primary)}.gallery img{width:100%;height:100%;object-fit:cover}.gallery-main{height:520px;padding:0;overflow:hidden;border:0;border-radius:12px;background:var(--color-surface-soft)}.gallery-main img{transition:transform .25s ease}.gallery-main img.is-zoomed{transform:scale(1.35);cursor:zoom-out}.detail-info>p:first-child{margin:0;color:var(--color-brand-primary);font-family:var(--font-pixel);font-size:9px;line-height:16px}.detail-info h1{margin:22px 0 8px;font-size:36px;font-weight:500;line-height:46px}.detail-short{min-height:48px;margin:0;color:var(--color-muted);font-size:16px;line-height:24px}.specs{display:grid;grid-template-columns:repeat(2,1fr);gap:16px 28px;margin-top:21px}.specs div{min-height:74px;padding:10px 11px;border:1px solid var(--color-border);border-radius:12px}.specs small{display:block;color:var(--color-muted);font-family:var(--font-pixel);font-size:8px;line-height:14px}.specs span{display:block;margin-top:8px;font-size:13px;line-height:20px}.quote{display:grid;height:44px;place-items:center;margin-top:42px;border-radius:8px;background:var(--color-brand-primary);color:white;font-size:14px;font-weight:500;text-decoration:none}.description{display:grid;grid-template-columns:1fr 652px;gap:28px;min-height:254px;margin-top:64px;padding:28px 32px;border-radius:12px;background:#fff}.description h2,.related h2{margin:0;font-family:var(--font-pixel);font-size:12px;line-height:18px}.description p{white-space:pre-line;color:var(--color-muted);font-size:15px;line-height:24px}.detail-images{display:grid;grid-template-columns:1fr 1fr;gap:18px}.detail-images img{width:100%;height:190px;object-fit:cover;border-radius:12px}.related{margin-top:50px}.related>div{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;margin-top:30px}.related a{display:block;padding:12px;border:1px solid var(--color-border);border-radius:12px;color:var(--color-ink);text-decoration:none}.related img{width:100%;height:150px;object-fit:cover;border-radius:12px}.related small,.related strong,.related span{display:block}.related small{width:max-content;margin-top:8px;padding:4px 6px;border:1px solid var(--color-border);border-radius:8px;font-size:11px}.related strong{margin-top:8px;font-size:18px;line-height:26px}.related span{display:-webkit-box;overflow:hidden;margin-top:5px;color:var(--color-muted);font-size:12px;line-height:18px;-webkit-box-orient:vertical;-webkit-line-clamp:2}@media(max-width:767px){.detail{width:calc(100% - 32px);margin-top:20px}.crumb{overflow:hidden;font-size:10px;white-space:nowrap}.detail-top{display:block;margin-top:28px}.gallery{display:flex;flex-direction:column-reverse;gap:16px}.gallery-thumbs{display:flex;gap:12px;overflow:auto}.gallery-thumbs button{min-width:68px;height:68px}.gallery-main{height:343px}.detail-info{margin-top:38px}.detail-info h1{margin-top:14px;font-size:28px;line-height:38px}.specs{gap:16px}.quote{margin-top:26px}.description{display:block;min-height:190px;margin-top:60px;padding:20px}.description p{font-size:13px;line-height:21px}.detail-images{margin-top:20px}.detail-images img{height:164px}.related{margin-top:40px}.related>div{display:flex;overflow:auto;gap:16px}.related a{min-width:291px}.related>div::-webkit-scrollbar{display:none}}
</style>
